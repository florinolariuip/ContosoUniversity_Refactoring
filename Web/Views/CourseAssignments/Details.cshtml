@model Domain.Entities.CourseAssignment

@{
    ViewData["Title"] = "Course Assignment Details";
}

<h1>Course Assignment</h1>
<dl class="row">
    <dt class="col-sm-2">Instructor</dt>
    <dd class="col-sm-10">@Model.Instructor?.FullName</dd>
    <dt class="col-sm-2">Course</dt>
    <dd class="col-sm-10">@Model.Course?.Title</dd>
</dl>
<p>
    <a asp-action="Delete" asp-route-instructorId="@Model.InstructorID" asp-route-courseId="@Model.CourseID">Delete</a> |
    <a asp-action="Index">Back to List</a>
</p>

