@model IEnumerable<Domain.Entities.CourseAssignment>

@{
    ViewData["Title"] = "Course Assignments";
}

<h1>Course Assignments</h1>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Instructor</th>
            <th>Course</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        <td>@item.Instructor?.FullName</td>
        <td>@item.Course?.Title</td>
        <td>
            <a asp-action="Details" asp-route-instructorId="@item.InstructorID" asp-route-courseId="@item.CourseID">Details</a> |
            <a asp-action="Delete" asp-route-instructorId="@item.InstructorID" asp-route-courseId="@item.CourseID">Delete</a>
        </td>
    </tr>
}
    </tbody>
</table>

