@model Domain.Entities.Enrollment

@{
    ViewData["Title"] = "Enrollment Details";
}

<h1>Enrollment</h1>
<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>
    <dt class="col-sm-2">Course</dt>
    <dd class="col-sm-10">@Model.Course?.Title</dd>
    <dt class="col-sm-2">Student</dt>
    <dd class="col-sm-10">@Model.Student?.FullName</dd>
    <dt class="col-sm-2">Grade</dt>
    <dd class="col-sm-10">@Model.Grade</dd>
</dl>
<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</p>

